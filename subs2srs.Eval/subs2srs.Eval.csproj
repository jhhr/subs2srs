<Project Sdk="Microsoft.NET.Sdk">
  <!-- Grouping evaluation console (plan §9.3). Not shipped; the only place that calls a provider on a whole set. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>subs2srs.Eval</RootNamespace>
    <AssemblyName>subs2srs.Eval</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../subs2srs/subs2srs.csproj" />
  </ItemGroup>
</Project>
